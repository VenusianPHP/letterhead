{
    "name": "venusian/letterhead",
    "description": "Bitmap faces for Venusian Surface: FreeSans, FreeSerif, FreeMono, Montserrat, U8g2, HelvB, Unscii, Logisoso and four one-offs.",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "venusian",
        "surface",
        "fonts",
        "bitmap",
        "gfxfont"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "surface/contracts": "^0.8.0",
        "surface/fonts": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Letterhead\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Letterhead\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "Letterhead\\LetterheadServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/venusian/surface/src/Surface/*",
            "options": {
                "symlink": true,
                "versions": {
                    "surface/contracts": "0.8.0",
                    "surface/fonts": "0.8.0"
                }
            }
        },
        {
            "type": "path",
            "url": "/Volumes/ProjectSaturnStudios/Development/PHP/ProjectSaturnStudios/dev/venusian/framework/src/Voyager/*",
            "options": {
                "symlink": true,
                "versions": {
                    "venusian-voyager/collections": "0.8.9",
                    "venusian-voyager/conditionable": "0.8.9",
                    "venusian-voyager/config": "0.8.9",
                    "venusian-voyager/console": "0.8.9",
                    "venusian-voyager/contracts": "0.8.9",
                    "venusian-voyager/filesystem": "0.8.9",
                    "venusian-voyager/io-pools": "0.8.9",
                    "venusian-voyager/macroable": "0.8.9",
                    "venusian-voyager/magic-aliases": "0.8.9",
                    "venusian-voyager/nuts-and-bolts": "0.8.9",
                    "venusian-voyager/reflection": "0.8.9",
                    "venusian-voyager/vessel": "0.8.9"
                }
            }
        }
    ]
}
