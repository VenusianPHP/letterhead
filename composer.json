{
    "name": "venusian/letterhead",
    "description": "Bitmap faces for Venusian Surface: FreeSans, FreeSerif, FreeMono, Montserrat, U8g2, HelvB, Unscii, Logisoso and four one-offs.",
    "type": "library",
    "version": "0.8.1",
    "keywords": [
        "venusian",
        "surface",
        "fonts",
        "bitmap",
        "gfxfont"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "surface/contracts": "^0.8.0",
        "surface/fonts": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Letterhead\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Letterhead\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "Letterhead\\LetterheadServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
